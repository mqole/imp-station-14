<DefaultWindow
    SetSize="400 400"
    MinSize="400 200"
    Margin="4 0"
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls">
    <BoxContainer Orientation="Vertical"
                HorizontalAlignment="Center">
        <!-- Pronouns List -->
        <PanelContainer HorizontalExpand="True"
                        StyleClasses="BorderedWindowPanel">
            <BoxContainer Orientation="Vertical">
                <BoxContainer Orientation="Horizontal"
                            HorizontalExpand="True"
                            SeparationOverride="4"
                            Margin="0 0 25 0">
                    <Label Name="InflectionLabel"
                        Margin="5 5 5 5"
                        SizeFlagsStretchRatio="1"
                        HorizontalExpand="True"
                        ClipText="True"
                        Text="{Loc edit-pronouns-inflection}"
                        ToolTip="{Loc edit-pronouns-inflection-tooltip}"
                        MouseFilter="Pass"/>
                    <cc:VSeparator/>
                    <Label Name="PronounLabel"
                        Margin="5 5 5 5"
                        SizeFlagsStretchRatio="1"
                        HorizontalExpand="True"
                        ClipText="True"
                        Text="{Loc edit-pronouns-pronoun}"
                        ToolTip="{Loc edit-pronouns-pronoun-tooltip}"
                        MouseFilter="Pass"/>
                </BoxContainer>
                <BoxContainer Name="PronounContainer"
                            Access="Public"
                            Orientation="Vertical"
                            VerticalExpand="True">
                    <ScrollContainer VerticalExpand="True"
                                    MinWidth="200"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
        <!-- Buttons -->
        <BoxContainer Orientation="Vertical"
                      Margin="5 5 5 0"
                      HorizontalAlignment="Center">
            <OptionButton Name="NewDropdown"
                        Visible="false"
                        Margin="5 5 5 5"/>
            <BoxContainer Orientation="Horizontal">
                <Button Name="AddButton"
                        Text="{Loc 'edit-pronouns-add'}"
                        StyleClasses="OpenRight"/>
                <Button Name="ResetButton"
                        Text="{Loc 'edit-pronouns-reset'}"
                        StyleClasses="OpenBoth"/>
                <Button Name="SaveButton"
                        Text="{Loc 'edit-pronouns-save'}"
                        StyleClasses="OpenLeft"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
