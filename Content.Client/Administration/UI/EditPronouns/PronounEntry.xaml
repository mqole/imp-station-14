                  HorizontalExpand="True"
                  SeparationOverride="4">
        <Label Name="InflectionLabel"
               SizeFlagsStretchRatio="3"
               HorizontalExpand="True"
               MouseFilter="Pass"
               ClipText="True"/>
        <cc:VSeparator/>
